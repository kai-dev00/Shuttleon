# Local development uses the TEST Supabase project: copy this file to .env.local and fill it in
# (Supabase dashboard -> Project Settings -> API).
# Published builds do NOT read this file. They get the PRODUCTION project's values from the build
# profiles in eas.json.
# Use the publishable (anon) key only; never put the service-role/secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
