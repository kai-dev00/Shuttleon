{
  "expo": {
    "name": "Cockers",
    "slug": "BadMen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#c2ff6d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaidev00.cockers"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#c2ff6d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kaidev00.cockers"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "scheme": "cockers",
    "extra": {
      "eas": {
        "projectId": "fee307f5-1dfe-474e-a5a1-d22289a850e5"
      }
    },
    "owner": "kaiiuue"
  }
}
